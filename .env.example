POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=erp_base
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=
DB_CONTAINER_NAME=erp-base-db

API_IMAGE=fjmedina21/erp-base-api:latest
API_CONTAINER_NAME=erp-base-api
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

CLOUDINARY_CLOUD_NAME=YourCloudinaryCloudNameHere
CLOUDINARY_API_KEY=YourCloudinaryApiKeyHere
CLOUDINARY_API_SECRET=YourCloudinaryApiSecretHere
CLOUDINARY_FOLDER=YourCloudinaryFolderHere

SEED_ADMIN_EMAIL=admin@erp.com
SEED_ADMIN_PASSWORD=YourStrongPasswordHere

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_ENABLE_SSL=true
EMAIL_SMTP_USERNAME=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-gmail-app-password
EMAIL_SMTP_FROM_EMAIL=your-email@gmail.com
EMAIL_SMTP_FROM_NAME=ERP Base
